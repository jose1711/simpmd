CATEGORI;1;MGLD 0B, JUMP 1000;;;Categoric (M. Urda): LEFT = ->, RIGHT = <-, FIRE = K0 (F1), libovolna klavesa start;;
COBRA;1;MGLD 05, JUMP 5B00;Left=End,Right=PageDown,Up=A,Down=Left Shift,E=A,Z=Left Shift,H=1,I=2,Keypad +=3,Return=Keypad 5;Left:Left,Right:Right,Up:Up,Down:Down,1:1,2:2,3:3,Space:Space,Stop:Keypad 5,Esc:Escape;mezernik hra, 1 2 3 rychlost, sipky vlevo/vpravo, A nahoru, Shift dolu, Num 5 stop. Start: 1, vlevo a HNED dolu (uzka kapsa);P;
COSMIC;2;ROM basic2.rmm, FONT, TYPE LOAD 1, TYPE RUN;Left=F10,Right=F12,E=F8,Z=F11,Up=F8,Down=F11,Space=F1,Left Shift=F2;Left:F10,Right:F12,Up:F8,Down:F11,K0:F1,K1:F2,Esc:Escape;pohyb: F10 vlevo, F12 vpravo, F11 akce, Enter na zacatku (pad: D-pad, A = F1, LB = F2, B = Enter);P;
CROSFIRE;1;MGLD 00, JUMP 0000, POKE 39A4 01;;;Crossfire: libovolna klavesa start;;
CROSSI;1;MGLD 00, JUMP 0000, POKE 39A4 01;;;menu: M ovladani (8 klaves, nastavitelne), S rychlost, G hra;;
DOMCEKY;2;MGLD 00, JUMP 0000;Left=F1,Down=F2,Up=F3,Right=F4,pad:left=F1,pad:down=F2,pad:up=F3,pad:right=F4,pad:a=Space,pad:b=F5,pad:start=Return,pad:back=F12,pad:ls=Keypad +,pad:rs=Keypad +;Left:Left,Right:Right,Up:Up,Down:Down,Enter:Return,Level 1:F2,Level 2:F3,Level 3:F4,Level 4:F5,Menu:F12,Info:Keypad +,Esc:Escape;sipky, mezera start, Enter potvrdit, F12 menu, F2-F5 uroven, Num+ (RCL) info;P;Pro nejmensi
ELKA;2;ROM basic2.rmm, FONT, TYPE LOAD 0, TYPE RUN;;;F1 ano, F2 ne (K0, K1), tahy se zadavaji z klavesnice, Enter;;
ERB;2;ROM basic2.rmm, FONT, TYPE LOAD 1, TYPE RUN;Left=F10,Right=F12,E=F8,Z=F11,Up=F8,Down=F11,Space=F1,Left Shift=F2;Left:F10,Right:F12,Up:F8,Down:F11,K0:F1,K1:F2,Esc:Escape;pohyb: F10 vlevo, F12 vpravo, F8 nahoru, F11 dolu, F1 akce (pad: D-pad, A = F1, LB = F2, B = Enter);P;
FARAON;2;ROM basic2.rmm, FONT, TYPE LOAD 3, TYPE RUN;;;P vpravo, L vlevo, H nahoru, D dolu, Enter, odpovedi A/N, jmeno z klavesnice;;Textove adventury
FERLAJT;1;MGLD 13;Space=Return;Enter:Return,Esc:Escape;hudebni demo, staci Enter (TV: OK, pad: A, B nebo Start);PR;Dema
FLAPPY;1;MGLD 03;Up=E,Down=Z;E up:e,Y down:z,Left:Left,Right:Right,Space:Space,Enter:Return,H:h,I:i,Shift:Left Shift,RCL:Keypad +,Stop:Left Ctrl,F1:F1,Esc:Escape;E/Y nahoru/dolu, Space = hod, F1 = konec, Stop (Ctrl) = reset, kody jen klavesnici;;FLAPPY
FRED;2;MGLD 03;;E up:e,Y down:z,Left:Left,Right:Right,Space:Space,H:h,RCL:Keypad +,Esc:Escape;H start hry, RCL rychlost ptaku, sipky vlevo/vpravo, E/Y, Space start (pad: X = H, RB = RCL, A = Space);P;FRED
FRED-4;1;MGLD 03;;E up:e,Y down:z,Left:Left,Right:Right,Space:Space,H:h,RCL:Keypad +,Esc:Escape;H start hry, RCL rychlost ptaku, sipky vlevo/vpravo, E/Y, Space start (pad: X = H, RB = RCL, A = Space) (verze +4 pro oba typy PMD, VBG software 1988);P;FRED
GALAXIA;1;MGLD 00;;Space:Space,M:m,T:t,Z:y,S:s,Enter:Return,Backspace:Backspace,Esc:Escape;Space start, M/T/Z/S vyber, Enter potvrzeni, Backspace maze;;GALAXIA
